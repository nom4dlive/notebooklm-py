# Copy to .env (which is gitignored) and fill in. NEVER commit real values.
# Or just run `make setup-server` — it generates the secrets below and
# writes this file for you.

# === CONFIGURAÇÃO DO SERVIDOR REST PARA FRONTENDS ===

# Token de autenticação para frontends (OBRIGATÓRIO)
# Gere um valor forte: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Frontends devem enviar: Authorization: Bearer <token>
NOTEBOOKLM_SERVER_TOKEN=

# Permitir bind externo (necessário para 0.0.0.0)
# Deixe como 1 — o token acima protege o acesso
NOTEBOOKLM_SERVER_ALLOW_EXTERNAL_BIND=1

# Porta do servidor REST (acessível via localhost no host)
NOTEBOOKLM_SERVER_PORT=8000

# Habilitar documentação OpenAPI/Swagger (0 = desabilitado, 1 = habilitado)
# Se habilitado, acesse: http://localhost:8000/docs (Swagger UI)
#                        http://localhost:8000/redoc (ReDoc)
#                        http://localhost:8000/openapi.json (spec JSON)
NOTEBOOKLM_SERVER_ENABLE_DOCS=0

# CORS origins (opcional, separado por vírgulas)
# Ex: https://meufrontend.com,https://app.exemplo.com
# Deixe vazio para desabilitar CORS (recomendado para produção com tunnel)
NOTEBOOKLM_SERVER_CORS_ORIGINS=

# Rate limiting (opcional)
# Número máximo de requisições por janela de tempo
NOTEBOOKLM_SERVER_RATE_LIMIT_REQUESTS=100
NOTEBOOKLM_SERVER_RATE_LIMIT_WINDOW=60

# === PERFIL DO GOOGLE (autenticação) ===

# Diretório do perfil (criado com: notebooklm login --master-token)
# Padrão: ~/.notebooklm/profiles/default
# Recomendação: use um perfil dedicado/throwaway para servidores
# NOTEBOOKLM_PROFILE_DIR=/home/voce/.notebooklm/profiles/server

# UID:GID do usuário no host (para permissões corretas dos arquivos)
# O comando `make` preenche automaticamente com id -u:id -g
# NOTEBOOKLM_UID=1000
# NOTEBOOKLM_GID=1000

# === TUNNEL (escolha UM para expor publicamente) ===

# Opção A: Cloudflare Tunnel (precisa de domínio na conta Cloudflare)
# Token: Cloudflare dashboard → Networks → Tunnels → seu tunnel → token
# Rota: Routes → Add route → Service URL: http://notebooklm-rest:8000
CF_TUNNEL_TOKEN=

# Versão opcional do cloudflared (padrão: latest)
# CLOUDFLARED_VERSION=2025.1.0

# Opção B: Tailscale Funnel (SEM domínio, usa *.ts.net gratuito)
# Pré-requisitos no admin console do Tailscale:
#   1. Ativar MagicDNS + HTTPS certificates
#   2. Grants → Funnel → Add "funnel" node attribute à policy
# TS_AUTHKEY=tskey-auth-xxxxxxxx
# NOTEBOOKLM_SERVER_OAUTH_BASE_URL=https://notebooklm-rest.<tailnet>.ts.net

# === OPÇÕES AVANÇADAS ===

# Logging de auditoria (0 = desabilitado, 1 = habilitado)
# Loga todas as requisições autenticadas para /v1/*
# NOTEBOOKLM_SERVER_AUDIT_LOG=0

# Timeout para artefatos longos (vídeos, podcasts) em segundos
# Aumente para geração de conteúdo pesado
# NOTEBOOKLM_SERVER_ARTIFACT_TIMEOUT=600
