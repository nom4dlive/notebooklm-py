# Convenience wrapper for the remote notebooklm deploy.
#
# SERVIDOR MCP (para agentes de IA como Claude Code):
#   make setup                  — interactive first run: pick a tunnel + generate secrets → .env
#   make up                     — pull the published image and start (the easy path)
#   make prod VERSION=x.y.z      — pull a specific published version and start
#   make dev                    — build THIS checkout + start (contributors)
#   make dev TUNNEL=tailscale   — same, but with the Tailscale Funnel sidecar (no domain)
#
# SERVIDOR REST (para frontends web/mobile):
#   make setup-server           — gera .env.server com token e configurações
#   make up-server              — sobe servidor REST para frontends
#   make dev-server             — build THIS checkout + start REST server
#   make logs-server            — tail logs do servidor REST
#   make down-server            — para servidor REST
#
# TUNNEL selects the tunnel sidecar (Compose profile): cloudflare (default) or tailscale.
# Override the compose command with COMPOSE=... if needed.

COMPOSE ?= docker compose
_TUNNEL_DOTENV := $(shell [ -f .env ] && sed -n 's/^TUNNEL=//p' .env | tr -d '\r' | head -1)
TUNNEL ?= $(if $(_TUNNEL_DOTENV),$(_TUNNEL_DOTENV),cloudflare)

_OAUTH_STATE_DOTENV := $(shell [ -f .env ] && sed -n 's/^NOTEBOOKLM_OAUTH_STATE_DIR=//p' .env | tr -d '\r' | head -1)
OAUTH_STATE_DIR ?= $(or $(NOTEBOOKLM_OAUTH_STATE_DIR),$(_OAUTH_STATE_DOTENV),./oauth-state)

_PROJECT_VERSION := $(shell [ -f ../pyproject.toml ] && sed -n '/^\[project\]/,/^\[/ s/^[[:space:]]*version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' ../pyproject.toml | tr -d '\r' | head -1)
_VERSION_DOTENV := $(shell [ -f .env ] && sed -n 's/^NOTEBOOKLM_MCP_VERSION=//p' .env | tr -d '\r' | head -1)
ifeq ($(origin VERSION),command line)
ifneq ($(strip $(VERSION)),)
COMPOSE_ENV := NOTEBOOKLM_MCP_VERSION=$(VERSION)
endif
else ifneq ($(origin NOTEBOOKLM_MCP_VERSION),undefined)
COMPOSE_ENV :=
else ifneq ($(_VERSION_DOTENV),)
COMPOSE_ENV :=
else ifneq ($(_PROJECT_VERSION),)
COMPOSE_ENV := NOTEBOOKLM_MCP_VERSION=$(_PROJECT_VERSION)
endif

DC = $(COMPOSE_ENV) $(COMPOSE) --profile $(TUNNEL)
DC_BUILD = $(DC) -f docker-compose.yml -f docker-compose.build.yml
DC_SERVER = $(COMPOSE) -f docker-compose.server.yml --profile $(TUNNEL)
DC_SERVER_BUILD = $(DC_SERVER) up -d --build

export NOTEBOOKLM_UID ?= $(shell id -u)
export NOTEBOOKLM_GID ?= $(shell id -g)
export GIT_COMMIT ?= $(shell [ -e ../.git ] && git -C .. rev-parse --short=8 HEAD 2>/dev/null)

.PHONY: help setup setup-server dev dev-server prod up up-server restart restart-server logs logs-server down down-server config _require-image-version _require-tunnel-token _ensure-state-dir

help: ## Show this help
@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

_require-image-version:
@if [ -z "$(COMPOSE_ENV)" ] && [ -z "$$NOTEBOOKLM_MCP_VERSION" ] && ! grep -qsE '^NOTEBOOKLM_MCP_VERSION=.+' .env; then echo "✗ NOTEBOOKLM_MCP_VERSION is unknown"; exit 1; fi

_require-tunnel-token:
@if [ "$(TUNNEL)" = "cloudflare" ]; then { [ -n "$$CF_TUNNEL_TOKEN" ] || grep -qsE '^CF_TUNNEL_TOKEN=.+' .env; } || { echo "✗ TUNNEL=cloudflare needs CF_TUNNEL_TOKEN"; exit 1; }; elif [ "$(TUNNEL)" = "tailscale" ]; then { [ -n "$$TS_AUTHKEY" ] || grep -qsE '^TS_AUTHKEY=.+' .env; } || { echo "✗ TUNNEL=tailscale needs TS_AUTHKEY"; exit 1; }; else echo "✗ Unknown TUNNEL=$(TUNNEL)"; exit 1; fi

_ensure-state-dir:
@mkdir -p "$(OAUTH_STATE_DIR)" && chmod 700 "$(OAUTH_STATE_DIR)"

setup: ## Interactive first run: pick a tunnel + generate secrets → writes .env
@sh setup.sh

up: prod ## Pull the published image and start

prod: _require-image-version _require-tunnel-token _ensure-state-dir ## Pull a published version and start
$(DC) pull
$(DC) up -d

dev: _require-image-version _require-tunnel-token _ensure-state-dir ## Build THIS checkout and start
$(DC_BUILD) up -d --build

restart: _require-image-version _require-tunnel-token _ensure-state-dir ## Rebuild after source/config change
$(DC_BUILD) up -d --build

logs: ## Tail the server logs
$(COMPOSE) logs -f notebooklm-mcp

down: ## Stop and remove the stack
$(DC) down

config: ## Validate the merged compose config
$(DC) config

setup-server: ## Gera .env.server com token e configurações para servidor REST
@echo "# Generated by make setup-server on $$(date)" > .env.server
@echo "" >> .env.server
@echo "NOTEBOOKLM_SERVER_TOKEN=$$(python -c 'import secrets; print(secrets.token_urlsafe(32))')" >> .env.server
@echo "NOTEBOOKLM_SERVER_ALLOW_EXTERNAL_BIND=1" >> .env.server
@echo "NOTEBOOKLM_SERVER_PORT=8000" >> .env.server
@echo "NOTEBOOKLM_SERVER_ENABLE_DOCS=0" >> .env.server
@echo "TUNNEL=cloudflare" >> .env.server
@echo "CF_TUNNEL_TOKEN=" >> .env.server
@echo "NOTEBOOKLM_UID=$(shell id -u)" >> .env.server
@echo "NOTEBOOKLM_GID=$(shell id -g)" >> .env.server
@echo "✓ .env.server gerado. Edite e execute: make up-server"

up-server: _ensure-state-dir ## Sobe servidor REST para frontends
$(DC_SERVER) up -d

dev-server: _ensure-state-dir ## Build THIS checkout and start REST server
$(DC_SERVER_BUILD)

restart-server: _ensure-state-dir ## Rebuild REST server after source/config change
$(DC_SERVER_BUILD)

logs-server: ## Tail logs do servidor REST
$(COMPOSE) -f docker-compose.server.yml logs -f notebooklm-rest

down-server: ## Stop and remove the REST server stack
$(DC_SERVER) down

test-server: ## Testa endpoint de health do servidor REST
@echo "Testando saúde do servidor REST..."
@TOKEN=$$(grep NOTEBOOKLM_SERVER_TOKEN .env.server 2>/dev/null | cut -d= -f2); if [ -z "$$TOKEN" ]; then echo "✗ TOKEN não encontrado"; exit 1; fi; curl -s -H "Authorization: Bearer $$TOKEN" http://localhost:8000/healthz && echo "✓ Servidor saudável" || echo "✗ Servidor indisponível"
